# Byte-compiled / caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
.venv-ci/
.venv-ci-backends/
.venv-ci-core/
venv/
env/

# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
.secrets.*
!.secrets.baseline

# A Kubernetes overlay holding an operator's own secrets (copied from
# overlays/local.example; src/lasagna/deploy/README.md, "Kubernetes").
src/lasagna/deploy/k8s/overlays/local/

# Credential material. No file of these types is tracked today, and none should
# ever be: the patterns exist so that a key dropped into the tree while
# debugging a deployment cannot become a commit via `git add -A`. The k8s
# `secrets.yaml` template is already tracked and is unaffected — it holds
# CHANGE_ME placeholders, not credentials.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
*credentials.json
service-account*.json
gha-creds-*.json
.pypirc
.npmrc

# Local working notes. They can hold absolute paths and unfinished thoughts, so
# they are kept out of an accidental `git add -A`.
MIGRATION_NOTE*.md
*_NOTE_20*.md
NOTES.md
notes/

# Runtime data: uploads, vector stores, SQLite databases
rag_uploads/
uploads/
dbs/
*.db
*.milvus.db
.milvus*

# Evaluation and experiment output
results/
logs/
*.log

# Frontend build artifacts (the configurator ships a prebuilt dist/ at
# release time; it is produced by CI, not committed from a dev machine)
node_modules/
src/lasagna/configurator/frontend/dist/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Coverage artefacts: a binary SQLite DB holding absolute local paths.
# Regenerated by every test run; was tracked by accident.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Release-gate reports record the local environment; CI uploads them as artifacts.
e2e/reports/
