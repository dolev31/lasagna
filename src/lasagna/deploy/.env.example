# =============================================================================
# Lasagna: Environment Configuration
# =============================================================================
# Quick start:
#   1. cp .env.example .env
#   2. Set RAG_JWT_SECRET and POSTGRES_PASSWORD below (required)
#   3. Choose your VECTOR_BACKEND
#   4. make up
#
# Every line here is also passed into the api, worker, beat and mcp containers,
# so API keys and RAG_* overrides set below take effect there.
# =============================================================================

# ---------------------------------------------------------------------------
# VECTOR BACKEND (required)
# ---------------------------------------------------------------------------
# Which vector database to use.  Must match a file in backends/.
# Options: milvus | milvus-lite | pgvector | qdrant | weaviate | pinecone | opensearch
#
# milvus (a Milvus server container, amd64 and arm64) is the default because the
# celery and mcp profiles below run in their own containers and need a server
# they can all reach. milvus-lite is embedded in the api process: use it only
# with COMPOSE_PROFILES= (empty); `make validate` refuses the combination.
VECTOR_BACKEND=milvus

# ---------------------------------------------------------------------------
# COMPOSE PROFILES: which optional services start
# ---------------------------------------------------------------------------
# Comma-separated list.  Available: celery, mcp, tracing
# Examples:
#   celery,mcp          Background processing + standalone MCP server
#   celery,mcp,tracing  Full stack with Jaeger tracing
#   (empty)             API only (Celery disabled, MCP embedded or off)
COMPOSE_PROFILES=celery,mcp

# ---------------------------------------------------------------------------
# HOST PORTS
# ---------------------------------------------------------------------------
API_PORT=8000
MCP_PORT=8005
REDIS_PORT=6379
POSTGRES_PORT=5432
# QDRANT_HTTP_PORT=6333
# QDRANT_GRPC_PORT=6334

# ---------------------------------------------------------------------------
# API SERVER
# ---------------------------------------------------------------------------
# Gunicorn worker count.  Set to 1 for milvus-lite (embedded single-process).
# WEB_CONCURRENCY=4
#
# Addresses of the reverse proxy whose X-Forwarded-For header is trusted for the
# client address (comma-separated). Unset trusts only loopback.
# FORWARDED_ALLOW_IPS=10.0.0.5

# ---------------------------------------------------------------------------
# MCP SERVER (profile: mcp)
# ---------------------------------------------------------------------------
# safe (default) leaves out the six tools that delete data or reset
# configuration; all serves every tool.
# LASAGNA_MCP_TOOLS=safe

# ---------------------------------------------------------------------------
# CELERY
# ---------------------------------------------------------------------------
# Leave RAG_CELERY_ENABLED unset: `make` sets it to true when COMPOSE_PROFILES
# includes celery and false otherwise, and `make validate` refuses true
# without the profile. When no worker answers, the api processes uploads in
# its own threads and logs why.
# RAG_CELERY_ENABLED=true
# CELERY_CONCURRENCY=4

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
# RAG_ENABLE_TRACING=false
# RAG_TRACING_ENDPOINT=http://jaeger:4317

# ---------------------------------------------------------------------------
# SECURITY (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
RAG_JWT_SECRET=

# Only with RAG_REQUIRE_AUTH=true: the API keys that may create sessions
# (comma-separated, each at least 32 characters; send one as X-API-Key).
# RAG_REQUIRE_AUTH=true
# RAG_API_KEYS=

# PostgreSQL password. Required: the stack refuses to start without one.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# BACKEND-SPECIFIC (set only for the backend you're using)
# ---------------------------------------------------------------------------
# These are automatically set by the backend fragment files (backends/*.yml)
# for Docker-internal services.  Override them here to use an EXTERNAL database.
#
# Milvus / Zilliz Cloud:
#   MILVUS_URI=http://milvus:19530          # Docker-internal (default)
#   MILVUS_URI=http://your-milvus:19530     # External self-hosted
#   MILVUS_TOKEN=                           # Required for Zilliz Cloud
#
# PgVector:
#   PGVECTOR_DSN=postgresql://rag:rag@postgres:5432/rag   # Docker-internal
#   PGVECTOR_DSN=postgresql://user:pass@db.prod:5432/rag  # External
#
# Qdrant:
#   QDRANT_URL=http://qdrant:6333           # Docker-internal (default)
#   QDRANT_URL=http://your-qdrant:6333      # External self-hosted
#   QDRANT_API_KEY=                         # Required for Qdrant Cloud
#
# Weaviate:
#   WEAVIATE_URL=http://weaviate:8080       # Docker-internal (default)
#   WEAVIATE_URL=http://your-weaviate:8080  # External self-hosted
#   WEAVIATE_API_KEY=                       # Required for Weaviate Cloud
#
# Pinecone (cloud-only):
#   PINECONE_API_KEY=your-api-key
#   PINECONE_ENVIRONMENT=us-east-1
#
# OpenSearch:
#   OPENSEARCH_HOSTS=http://opensearch:9200   # Docker-internal (default)
#   OPENSEARCH_HOSTS=http://your-opensearch:9200  # External self-hosted
#   OPENSEARCH_USER=admin                     # Basic auth username
#   OPENSEARCH_PASSWORD=admin                 # Basic auth password
#   OPENSEARCH_USE_SSL=false                  # Enable SSL
#   OPENSEARCH_VERIFY_CERTS=false             # Verify SSL certificates
#   OPENSEARCH_LANGUAGE=english               # BM25 language analyzer
#   OPENSEARCH_SHARDS=1                       # Index shards (>=2 for prod)
#   OPENSEARCH_REPLICAS=0                     # Index replicas (>=1 for prod)

# ---------------------------------------------------------------------------
# LLM API KEYS (at least one required for HyDE, agentic RAG, refinement)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# RAG CONFIGURATION OVERRIDES (optional; see docs/reference/settings.md for the full list)
# ---------------------------------------------------------------------------
# RAG_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# RAG_EMBEDDING_DIM=1024
# RAG_DEFAULT_TOP_K=75
# RAG_ENABLE_RERANKING=true
# RAG_ENABLE_HYBRID_SEARCH=true
# RAG_CHUNKING_STRATEGY=semantic
# RAG_LOG_LEVEL=INFO
# RAG_SETTINGS_FILE=settings.lasagna_production.toml
