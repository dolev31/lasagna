[24.988, "o", "\u001b[1mndcg@\u001b[0m\u001b[1;36m10\u001b[0m on beir/scifact \u2014 \u001b[1;36m1\u001b[0m pair, Holm-Bonferroni\r\n\r\n"]
[24.992, "o", "\u001b[1mpair                                \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m   diff\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m  d_z\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m      p\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mp (Holm)\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m  n\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1m           \u001b[0m\r\nreranker=cross_encoder                +0.0913  +0.38  1.0e-04   1.0e-04  100  \u001b[32msignificant\u001b[0m\r\nvs reranker=my_ideas:keyword_overlap                                                     \r\n"]
[24.992, "o", "\r\n"]
[24.993, "o", "\u001b[32m\u256d\u2500\u001b[0m\u001b[32m \u001b[0m\u001b[1;32msignificant after Holm correction\u001b[0m\u001b[32m \u001b[0m\u001b[32m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[32m\u2500\u256e\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1;32mreranker=cross_encoder\u001b[0m beats reranker=my_ideas:keyword_overlap              \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   ndcg@10 +0.0913 on beir/scifact, d_z +0.38, p (Holm) 1.0e-04, 100 queries \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m 1 of 1 pair survives correction at family-wise alpha=0.05.                  \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
